@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json


@inject HttpClient Http
@using InvestmentSimulator.Client.Models.Simulation.Deposit

<PageTitle>Investment Simulator</PageTitle>

<div class="row">
    <div class="col-md-4">
        <h1>Euro Deposit Simulator</h1>
        <p class="mb-4">See how your investment grows with real ECB rates.</p>

        <div class="card mb-4">
            <div class="card-body">
                <EditForm Model="@investmentInput" OnValidSubmit="@HandleValidSubmit" FormName="depositSimForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="initialAmount" class="form-label">Initial Amount (€)</label>
                        <InputNumber id="initialAmount" class="form-control" @bind-Value="investmentInput.InitialAmount" />
                        <ValidationMessage For="@(() => investmentInput.InitialAmount)" />
                    </div>

                    <div class="mb-3">
                        <label for="timePeriod" class="form-label">Time Period (Months)</label>
                        <InputNumber id="timePeriod" class="form-control" @bind-Value="investmentInput.TimePeriodInMonths" />
                        <ValidationMessage For="@(() => investmentInput.TimePeriodInMonths)" />
                    </div>

                    <div class="mb-3">
                        <label for="term" class="form-label">Investment Term</label>
                        <InputSelect id="term" class="form-select" @bind-Value="investmentInput.Term">
                            <option value="@InvestmentTerm.UpTo1Year">Up to 1 Year</option>
                            <option value="@InvestmentTerm.Over2Years">Over 2 Years</option>
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <select id="country" class="form-select" @onchange="OnCountryChanged">
                            <option value="">Select a country</option>
                            @foreach (var c in countryTaxRates)
                            {
                                <option value="@c.Country">@c.Country</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="taxRate" class="form-label">Capital Gains Tax Rate (%) (Optional)</label>
                        <InputNumber id="taxRate" class="form-control" @bind-Value="investmentInput.TaxRate" />
                        <div class="form-text">This value is filled automatically when you select a country, but you can change it manually.</div>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isSimulating">
                        @if (isSimulating)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Simulating...</span>
                        }
                        else
                        {
                            <span>Simulate</span>
                        }
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        <strong>Error:</strong> @errorMessage
                    </div>
                }

            </div>
        </div>

        <div class="card">
            <div class="card-header">Live Economic Indicators</div>
            <div class="card-body">
                @if (isMarketDataLoading)
                {
                    <div class="d-flex align-items-center">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-2">Loading market data...</span>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Eurozone Inflation (HICP)
                            <span class="badge bg-primary rounded-pill">@(FormatRate(latestInflationRate))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Deposit Rate (&lt;1Y)
                            <span class="badge bg-primary rounded-pill">@(FormatRate(depositRateUpToOneYear))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Deposit Rate (&gt;2Y)
                            <span class="badge bg-primary rounded-pill">@(FormatRate(depositRateOverTwoYears))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            ECB Deposit Facility
                            <span class="badge bg-primary rounded-pill">@(FormatRate(depositFacilityRate))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            10Y Gov. Bond Yield
                            <span class="badge bg-primary rounded-pill">@(FormatRate(tenYearGovernmentBondYield))</span>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </div>

    @if (simulationResult != null)
    {
        <div class="col-md-8">
            @if (simulationResult.UsedFallbackData)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Warning:</strong> Could not retrieve live market data from the ECB. The simulation was run using estimated rates (2.5% interest, 2.0% inflation).
                </div>
            }
            <h2>Simulation Result</h2>
            
            <div class="card bg-light mb-3">
                <div class="card-header">Summary</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <p><strong>Final Net Value:</strong> <span class="text-success">@simulationResult.FinalNetValue.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</span></p>
                            <p><strong>Net Interest Earned:</strong> @simulationResult.NetInterestEarned.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</p>
                        </div>
                        <div class="col-sm-6">
                            <p><strong>Final Real Value (after inflation):</strong> <span class="text-info">@simulationResult.FinalRealValue.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</span></p>
                            <p><strong>Real Interest Earned:</strong> @simulationResult.RealInterestEarned.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">Breakdown</div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Total Interest Earned (Gross)
                                <span>@simulationResult.TotalInterestEarned.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Total Tax Paid
                                <span class="text-danger">-@simulationResult.TotalTaxPaid.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Value Lost to Inflation
                                <span class="text-warning">-@simulationResult.TotalValueLostToInflation.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                     <div class="card mb-3">
                        <div class="card-header">Context</div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                ECB Interest Rate Used
                                <span>@simulationResult.InterestRateUsed.ToString("F2")%</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Eurozone Inflation Rate Used
                                <span>@simulationResult.InflationRateUsed.ToString("F2")%</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <h3>Yearly Evolution</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Starting Balance</th>
                        <th>Interest Earned</th>
                        <th>Ending Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in simulationResult.Evolution)
                    {
                        <tr>
                            <td>@item.Year</td>
                            <td>@item.StartingBalance.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</td>
                            <td>@item.InterestEarned.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</td>
                            <td>@item.EndingBalance.ToString("C", CultureInfo.GetCultureInfo("pt-PT"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DepositInput investmentInput = new();
    private DepositResult? simulationResult;
    private string? errorMessage;
    private bool isSimulating = false;
    private bool isMarketDataLoading = true;

    private double? latestInflationRate;
    private double? depositRateUpToOneYear;
    private double? depositRateOverTwoYears;
    private double? depositFacilityRate;
    private double? tenYearGovernmentBondYield;

    private List<CountryTaxRate> countryTaxRates = new()
    {
        new CountryTaxRate { Country = "Portugal", TaxRate = 28 },
        new CountryTaxRate { Country = "Spain", TaxRate = 19 },
        new CountryTaxRate { Country = "Germany", TaxRate = 25 },
        new CountryTaxRate { Country = "France", TaxRate = 30 },
        new CountryTaxRate { Country = "Italy", TaxRate = 26 },
        new CountryTaxRate { Country = "Netherlands", TaxRate = 31 },
        new CountryTaxRate { Country = "Belgium", TaxRate = 30 },
        new CountryTaxRate { Country = "United Kingdom", TaxRate = 20 },
        new CountryTaxRate { Country = "United States", TaxRate = 15 },
        new CountryTaxRate { Country = "Brazil", TaxRate = 15 },
        new CountryTaxRate { Country = "Other", TaxRate = 0 }
    };
    private string selectedCountry = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isMarketDataLoading = true;
        try
        {
            latestInflationRate = await Http.GetFromJsonAsync<double?>("/api/marketdata/inflation");
            depositRateUpToOneYear = await Http.GetFromJsonAsync<double?>("/api/marketdata/deposit-rate-up-to-one-year");
            depositRateOverTwoYears = await Http.GetFromJsonAsync<double?>("/api/marketdata/deposit-rate-over-two-years");
            depositFacilityRate = await Http.GetFromJsonAsync<double?>("/api/marketdata/deposit-facility-rate");
            tenYearGovernmentBondYield = await Http.GetFromJsonAsync<double?>("/api/marketdata/ten-year-government-bond-yield");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching market data: {ex.Message}");
            // Handle error appropriately, maybe set a flag to show an error message
        }
        finally
        {
            isMarketDataLoading = false;
        }
    }

    private string FormatRate(double? rate)
    {
        return rate.HasValue ? $"{rate.Value:F2}%" : "N/A";
    }

    private void OnCountryChanged(ChangeEventArgs e)
    {
        selectedCountry = e.Value?.ToString() ?? string.Empty;
        var found = countryTaxRates.FirstOrDefault(c => c.Country == selectedCountry);
        if (found != null && found.TaxRate > 0)
        {
            investmentInput.TaxRate = (decimal?)found.TaxRate;
        }
        else
        {
            investmentInput.TaxRate = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        isSimulating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/simulation/simulate", investmentInput);

            if (response.IsSuccessStatusCode)
            {
                simulationResult = await response.Content.ReadFromJsonAsync<DepositResult>();
            }
            else
            {
                simulationResult = null; 
                var errorContent = await response.Content.ReadAsStringAsync();
                
                try
                {
                    var validationProblemDetails = JsonSerializer.Deserialize<ValidationProblemDetails>(errorContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    var firstError = validationProblemDetails?.Errors.FirstOrDefault().Value.FirstOrDefault();
                    errorMessage = !string.IsNullOrEmpty(firstError) ? firstError : "An unknown validation error occurred.";
                }
                catch
                {
                    errorMessage = $"An error occurred: {errorContent}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"A communication error occurred: {ex.Message}";
        }
        finally
        {
            isSimulating = false;
        }
    }

    private class ValidationProblemDetails
    {
        public string Title { get; set; } = string.Empty;
        public Dictionary<string, string[]> Errors { get; set; } = new();
    }
}